PORT=8787

# 프론트엔드 배포 주소 (CORS 허용). 여러 개면 쉼표로 구분. 비워두면 localhost:5173만 허용합니다.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase — 비워두면 자동으로 mock 데이터로 동작합니다 (DB 없이도 전체 기능 확인 가능).
# 값을 채우면 briefing_snapshots 등 캐시 테이블을 우선 사용합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 실 데이터 소스가 준비되면 DATA_PROVIDER=live 로 전환하고 아래 키를 채우세요.
# 현재는 provider 인터페이스만 있고 실 구현은 비어 있습니다 (backend/src/providers/README.md 참고).
DATA_PROVIDER=mock
DART_API_KEY=
QUOTE_API_KEY=
NEWS_API_KEY=
