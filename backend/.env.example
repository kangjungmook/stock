PORT=8787

# 프론트엔드 배포 주소 (CORS 허용). 여러 개면 쉼표로 구분. 비워두면 localhost:5173만 허용합니다.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase — 비워두면 자동으로 mock 데이터로 동작합니다 (DB 없이도 전체 기능 확인 가능).
# 값을 채우면 briefing_snapshots 등 캐시 테이블을 우선 사용합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 아래 키들은 각각 독립적으로 동작합니다 — 채워진 것만 실 데이터로 전환되고,
# 비어 있으면 그 항목만 mock으로 남습니다 (backend/src/providers/README.md 참고).

# DART(전자공시시스템) — https://opendart.fss.or.kr, 무료 발급. 공시(§ 공시) 데이터.
DART_API_KEY=

# 토스증권 Open API — https://developers.tossinvest.com, OAuth2 client credentials.
# 시세·차트(§ 등락·차트) 데이터.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# KRX 정보데이터시스템 Open API — https://openapi.krx.co.kr. 수급(§ 외국인·기관 순매수) 데이터.
# 엔드포인트가 이 세션에서 네트워크 접근이 막혀 있어 미검증 상태입니다 — 배포 후 확인 필요.
KRX_AUTH_KEY=

# 뉴스 생성/요약용 AI 서비스 키. 어떤 서비스인지 확인 후 provider 구현을 맞춥니다.
NEWS_AI_KEY=

# 컨센서스(목표주가·투자의견)는 공식 무료 API가 없어 리포트 크롤링으로 대체합니다.
# 별도 키 없이 backend/src/providers/live/consensusProvider.ts에서 동작하며,
# 대상 사이트 구조가 바뀌면 깨질 수 있는 best-effort 구현입니다.
